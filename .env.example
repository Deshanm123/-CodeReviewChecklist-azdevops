# Backend configuration. Never commit real tokens or secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/code_review?schema=public"
PORT=3000
AZURE_DEVOPS_ORGANIZATION_URL="https://dev.azure.com/your-organization"
AZURE_DEVOPS_ORGANIZATION_ID="00000000-0000-0000-0000-000000000000"
DEVELOPER_FIELD_REFERENCE_NAME="Custom.Developer"
ALLOWED_ORIGINS="https://dev.azure.com,https://*.visualstudio.com,https://*.gallerycdn.vsassets.io"

# Vite build-time configuration for the Azure DevOps extension.
VITE_REVIEW_FINDINGS_API_URL="http://localhost:3000/api"
VITE_SUPPORTED_WORK_ITEM_TYPE="Product Backlog Item"
VITE_SUPPORTED_STATES="In Progress,Code Review Pending"
VITE_DEVELOPER_FIELD_REFERENCE_NAME="Custom.Developer"
